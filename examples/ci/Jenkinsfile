// BARE release gate — Jenkins declarative pipeline

pipeline {
  agent any

  environment {
    BARE_API_URL = credentials('bare-api-url')
    // A ci-scoped token: submit and receive a verdict, nothing more.
    BARE_TOKEN   = credentials('bare-token')
    ARTIFACT           = 'dist/installer.exe'
  }

  stages {
    stage('Build') {
      steps {
        sh './scripts/build.sh'
      }
    }

    stage('Release gate') {
      steps {
        // Attestation fills itself in from CHANGE_AUTHOR and BUILD_URL.
        // No `|| true`, and no catchError: a non-zero exit is the point.
        sh '''
          bare scan "$ARTIFACT" \
            --sarif bare.sarif \
            --json  bare-verdict.json \
            --timeout 1800
        '''
      }
      post {
        always {
          archiveArtifacts artifacts: 'bare-verdict.json,bare.sarif',
                           allowEmptyArchive: true
          recordIssues tools: [sarif(pattern: 'bare.sarif')]
        }
      }
    }

    stage('Publish') {
      when { buildingTag() }
      steps {
        sh './scripts/publish.sh'
      }
    }
  }
}
