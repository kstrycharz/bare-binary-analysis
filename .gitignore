# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Node / Next.js
node_modules/
web/.next/
web/out/
web/.turbo/
*.tsbuildinfo

# Local env & secrets — never commit
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key

# The dashboard's persisted API token, when the web app is run outside its
# container (in compose this lives in the `web-data` volume, not the repo).
web/data/

# Build & runtime output
dist/
build/
/var/
airgap-bundle/
*.tar.gz

# Synthetic test corpus is BUILT, never committed (sources live in tests/corpus/src)
tests/corpus/build/
tests/corpus/out/

# The release policy and its waivers are COMMITTED on purpose: the team that
# owns the artifact owns the definition of "shippable", and the file's git
# history is the audit trail for who weakened the gate and when (ADR-0019).
# Only local scratch under .bare/ is ignored.
.bare/cache/
.bare/*.local.yaml

# Scan output. These are per-run reports about a specific binary — they name
# internal paths, hostnames, and masked credentials, so they are the last thing
# that should land in a public repo by accident. Committing a baseline is a
# deliberate act; name it explicitly rather than letting the glob catch it.
*.sarif
*.cdx.json
bare-report-*.pdf
bare-report-*.html

# Working material from building this, not source. Kept locally; none of it
# belongs in a clone.
#
#   design/                    a 2.3 MB published Claude Design canvas, bundled
#                              editor and all, that nothing imports
#   UI_REDESIGN_BRIEF.md       written to be pasted into an agent, not read by
#                              a contributor
#   JOURNAL.md                 a session-by-session account of what was built
#                              and what broke. Useful to whoever is mid-build;
#                              not a document a reader of the repo wants. The
#                              decisions worth keeping are promoted to
#                              docs/ADR.md, which is written to be read.
design/
docs/UI_REDESIGN_BRIEF.md
docs/JOURNAL.md

# Editors
.vscode/
.idea/
*.swp

# Claude Code local settings (machine-specific; CLAUDE.md itself is committed)
.claude/settings.local.json

# Tool droppings
.DS_Store
Thumbs.db
*.log
