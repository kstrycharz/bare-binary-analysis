# Copy to .env and adjust. Every default here is the restrictive one.
# `.env` is gitignored; never commit real credentials to this repo.

# --- sandbox ----------------------------------------------------------------
# One directory, two paths. The worker spawns analyzer containers as siblings
# through the Docker socket, and the daemon resolves their bind mounts on the
# HOST — so the worker must tell it the host path, not its own.
#
#   _HOST : where the run root lives on the host (absolute; what the daemon sees)
#   (plain): where the worker sees it, fixed inside the image by compose
#
# On Windows use a Windows path here, e.g. C:\bare\runs — the driver
# translates. Getting this wrong yields analyzers with empty input directories
# and no error at all.
BARE_RUN_ROOT_HOST=/var/lib/bare/runs

# Only set this when running the orchestrator directly on the host rather than
# in compose; then it should equal BARE_RUN_ROOT_HOST.
# BARE_RUN_ROOT=/var/lib/bare/runs

BARE_SANDBOX_DRIVER=docker

# Tag for the analyzer images. Read by `make images` and by the orchestrator
# that runs them, so a build and a scan cannot disagree about which image they
# mean. `dev` is the local default; use a version or a git sha for anything you
# deploy. To pin one analyzer to a digest or another registry, set its full
# reference instead — BARE_STATIC_IMAGE / _UNPACK_IMAGE / _HELLO_IMAGE
# take precedence over this.
BARE_ANALYZER_TAG=dev

# CPU quota for one analyzer container, in whole cores. Rule matching is
# CPU-bound and the static analyzer parallelises across whatever quota it is
# given, reading the cgroup limit rather than the host core count. Measured
# on a 502-file .NET tree: 23.4s at 1 core, 12.8s at 2, 5.4s at 8.
BARE_ANALYZER_CPUS=4
BARE_REAPER_MAX_AGE_HOURS=6
BARE_REAPER_INTERVAL_SECONDS=300

# --- authentication ---------------------------------------------------------
# The API demands a bearer token by default. Leave BARE_TOKEN below
# empty (or unset entirely) and open the dashboard at http://localhost:3000 —
# a fresh deployment with no tokens lands on a one-time setup wizard that
# mints the first admin token and saves it for the dashboard automatically.
# No .env edit, no restart. A headless operator gets the same mint from
#   curl -X POST http://localhost:8000/api/setup/bootstrap
#
# Once you have a token, mint scoped ones for CI and revoke the bootstrap one:
#   docker compose exec api bare token create ci-pipeline --scope ci
#   docker compose exec api bare token revoke bootstrap
#
# Set to false ONLY for a single-user local stack. Never for anything another
# host can reach: a release gate whose verdict anyone can request is not a
# control, and the findings corpus is a list of your exposed secrets.
BARE_AUTH_REQUIRED=true

# Optional. Pins the dashboard to a token you minted yourself, bypassing its
# own setup wizard. Leave empty to let the wizard handle it.
BARE_TOKEN=

# --- trust boundary ---------------------------------------------------------
# deny = no component may make outbound network calls. Loosen only when a cloud
# LLM provider is deliberately configured (M3).
BARE_EGRESS_POLICY=deny
BARE_AIR_GAPPED=false
# Dynamic analysis executes the artifact. Opt-in, per run, and never by default.
BARE_DYNAMIC_ANALYSIS_ENABLED=false
# Discovered secrets are stored hashed and masked unless this is enabled.
BARE_RETAIN_PLAINTEXT_SECRETS=false

# Whether uploads must carry an authorization attestation. Off for rapid
# prototyping so there is no upload friction; the schema, audit records, and
# report stamping all remain, so turning it on restores the gate with nothing
# to rebuild. Turn it on before anyone analyses an artifact they did not build.
BARE_REQUIRE_ATTESTATION=false

# --- local ports ------------------------------------------------------------
BARE_API_PORT=8000
BARE_WEB_PORT=3000
BARE_POSTGRES_PORT=5432
BARE_REDIS_PORT=6379
BARE_MINIO_PORT=9000
BARE_MINIO_CONSOLE_PORT=9001

# --- development credentials (compose only; change for any real deployment) --
MINIO_ROOT_USER=bare
MINIO_ROOT_PASSWORD=bare

BARE_LOG_LEVEL=INFO
