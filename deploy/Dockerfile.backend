# Shared image for the API and the Celery worker. They differ only in command,
# so one image keeps their dependency sets provably identical — a worker that
# can import something the API cannot is a debugging afternoon nobody needs.
FROM python@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134 AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.14 /uv /usr/local/bin/uv

WORKDIR /app

# Dependency layer first: source changes must not invalidate the wheel cache.
COPY pyproject.toml uv.lock* ./
RUN uv venv /opt/venv \
 && uv pip install --python /opt/venv/bin/python -r pyproject.toml --extra dev

COPY core/ ./core/
COPY api/ ./api/
COPY cli/ ./cli/
COPY reporting/ ./reporting/
COPY mcp/ ./mcp/
COPY detections/ ./detections/
COPY config/ ./config/
COPY scripts/ ./scripts/
COPY sandbox/ ./sandbox/
COPY tests/ ./tests/
# The migration scripts ship with the image: a container that cannot
# migrate the database it is pointed at cannot start.
COPY alembic.ini ./
COPY alembic/ ./alembic/

# The worker talks to the Docker socket, which is root-equivalent on the host
# (see THREAT_MODEL.md). It is the one component that must, and it is why
# analyzers get their own hard-isolated containers instead of running here.
ENV BARE_REPO_ROOT=/app \
    PYTHONPATH=/app

# `bare` as a real command. The dependency layer above installs what
# pyproject.toml requires but not the project itself, so the console script it
# declares never existed here — and `docker compose exec api bare token
# create ...`, the documented way to bootstrap credentials, failed with
# "executable file not found".
#
# A shim rather than `pip install .`: the source already lives at /app on
# PYTHONPATH, and a second copy in site-packages turns every bug report into
# "which of the two is actually running?".
RUN printf '#!/bin/sh\nexec python -m cli.main "$@"\n' > /usr/local/bin/bare \
 && chmod +x /usr/local/bin/bare

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
